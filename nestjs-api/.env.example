# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, or self-hosted)
DATABASE_URL="postgresql://noon:noon_dev_pass@localhost:5432/noon_db?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-min-32-chars-long-secret-key-here"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="change-me-different-min-32-chars-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to disable CORS.
# Example: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=""
