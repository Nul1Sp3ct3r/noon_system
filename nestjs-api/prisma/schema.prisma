generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  super_admin
  admin
  user
  platform_admin
  merchant_owner
  merchant_accountant
  merchant_inventory
  merchant_data_entry
  merchant_viewer
}

enum MerchantStatus {
  trial
  active
  expired
  suspended
  cancelled
}

enum BillingCycle {
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  expired
  cancelled
  paused
  trial
}

enum PlatformPaymentStatus {
  paid
  pending
  failed
  refunded
}

enum VatMode {
  inclusive
  exclusive
  exempt
}

enum MovementType {
  purchase
  sale
  adjustment
  transfer_in
  transfer_out
  noon_return
  noon_sync
}

enum ImportType {
  orders
  monthly_statement
  inventory_sync
  weekly_noon
  full_inventory
  transaction_view
}

enum AccountType {
  asset       // أصول
  liability   // خصوم
  equity      // حقوق الملكية
  revenue     // إيرادات
  expense     // مصاريف
}

enum NormalBalance {
  debit
  credit
}

enum JournalStatus {
  draft
  posted
  reversed
}

enum ExpenseStatus {
  draft
  posted
  pending_approval
  approved
  paid
  rejected
}

enum PaymentMethod {
  bank_transfer
  cash
  credit_card
  check
  other
  treasury
  stc_pay
  employee_advance
  deferred
}

// ─── Organizations ─────────────────────────────────────────────────────────────

model Organization {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  isActive      Boolean  @default(true)  @map("is_active")
  vatRegistered Boolean  @default(false) @map("vat_registered")
  vatNumber     String?  @map("vat_number")
  profitMode    String   @default("expense") @map("profit_mode")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users                   User[]
  refreshTokens           RefreshToken[]
  products                Product[]
  invoices                Invoice[]
  warehouses              Warehouse[]
  movements               InventoryMovement[]
  orders                  Order[]
  importBatches           ImportBatch[]
  statementFees           StatementFee[]
  noonStatementSummaries  NoonStatementSummary[]
  auditLogs               AuditLog[]
  journalEntries          JournalEntry[]
  accounts                Account[]
  journalTemplates        JournalTemplate[]
  accountingPeriods       AccountingPeriod[]
  expenseCategories       ExpenseCategory[]
  expenses                Expense[]
  merchants               Merchant[]

  @@map("organizations")
}

// ─── Users & Auth ──────────────────────────────────────────────────────────────

model User {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @map("organization_id")
  username           String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String?   @map("full_name")
  email              String?
  phone              String?
  role               Role      @default(user)
  isActive           Boolean   @default(false) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastLogin          DateTime? @map("last_login")

  organization     Organization   @relation(fields: [organizationId], references: [id])
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  journalsCreated  JournalEntry[] @relation("JournalCreatedBy")
  periodsLocked    AccountingPeriod[] @relation("PeriodClosedBy")
  expensesCreated  Expense[]      @relation("ExpenseCreatedBy")

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  organizationId Int       @map("organization_id")
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Products ──────────────────────────────────────────────────────────────────

model Product {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  sku             String
  partnerSku      String?  @map("partner_sku")
  barcode         String?
  nameAr          String?  @map("name_ar")
  nameEn          String?  @map("name_en")
  brand           String?
  family          String?
  unitCost        Decimal? @map("unit_cost") @db.Decimal(12, 4)
  extraCosts      Decimal? @map("extra_costs") @db.Decimal(12, 4)
  costIncludesVat Boolean  @default(false) @map("cost_includes_vat")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  invoiceItems InvoiceItem[]
  movements    InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([sku])
  @@index([partnerSku])
  @@index([barcode])
  @@map("products")
}

// ─── Invoices ──────────────────────────────────────────────────────────────────

model Invoice {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  supplierName   String?   @map("supplier_name")
  invoiceNumber  String?   @map("invoice_number")
  internalRef    String?   @map("internal_ref")
  invoiceDate    DateTime? @map("invoice_date")
  vatMode        VatMode   @default(inclusive) @map("vat_mode")
  subtotal       Decimal?  @db.Decimal(14, 2)
  vatAmount      Decimal?  @map("vat_amount") @db.Decimal(12, 2)
  totalAmount    Decimal?  @map("total_amount") @db.Decimal(14, 2)
  notes           String?
  status          String    @default("active")
  voidReason      String?   @map("void_reason")
  voidedAt        DateTime? @map("voided_at")
  pdfData         Bytes?    @map("pdf_data")
  pdfFilename     String?   @map("pdf_filename")
  pdfOriginalName String?   @map("pdf_original_name")
  warehouseId    Int?      @map("warehouse_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse?          @relation(fields: [warehouseId], references: [id])
  items        InvoiceItem[]
  movements    InventoryMovement[]

  @@index([organizationId])
  @@index([invoiceDate])
  @@index([createdAt])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id           Int     @id @default(autoincrement())
  invoiceId    Int     @map("invoice_id")
  productId    Int?    @map("product_id")
  sku          String
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 4)
  vatRate      Decimal @default(0.15) @map("vat_rate") @db.Decimal(6, 4)
  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(14, 2)
  lineVat      Decimal @map("line_vat") @db.Decimal(12, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(14, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

// ─── Inventory ─────────────────────────────────────────────────────────────────

model Warehouse {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  code           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  movements    InventoryMovement[]
  invoices     Invoice[]

  @@index([organizationId])
  @@map("warehouses")
}

model InventoryMovement {
  id             Int          @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  productId      Int?         @map("product_id")
  sku            String
  warehouseId    Int?         @map("warehouse_id")
  invoiceId      Int?         @map("invoice_id")
  movementType   MovementType @map("movement_type")
  quantity       Int
  isVoid            Boolean       @default(false)  @map("is_void")
  reference         String?
  batchId           String?       @map("batch_id")
  notes             String?
  referenceType     String?       @map("reference_type")
  reasonCode        String?       @map("reason_code")
  unitCostOverride  Decimal?      @map("unit_cost_override") @db.Decimal(12, 4)
  createdAt         DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([organizationId])
  @@index([sku])
  @@index([batchId])
  @@index([invoiceId])
  @@index([createdAt])
  @@index([referenceType])
  @@index([reasonCode])
  @@map("inventory_movements")
}

// ─── Orders ────────────────────────────────────────────────────────────────────

model Order {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  orderNr        String    @map("order_nr")
  itemNr         String?   @map("item_nr")
  sku            String?
  partnerSku     String?   @map("partner_sku")
  productTitleEn String?   @map("product_title_en")
  productTitleAr String?   @map("product_title_ar")
  brandEn        String?   @map("brand_en")
  brandAr        String?   @map("brand_ar")
  itemStatus     String?   @map("item_status")
  netProceeds    Decimal?  @map("net_proceeds") @db.Decimal(12, 2)
  referralFee    Decimal?  @map("referral_fee") @db.Decimal(12, 2)
  fbnOutboundFee Decimal?  @map("fbn_outbound_fee") @db.Decimal(12, 2)
  totalPayment   Decimal?  @map("total_payment") @db.Decimal(12, 2)
  orderedDate    DateTime? @map("ordered_date")
  deliveredDate  String?   @map("delivered_date")
  returnedDate   String?   @map("returned_date")
  importBatch    String?   @map("import_batch")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([orderNr])
  @@index([itemNr])
  @@index([sku])
  @@index([partnerSku])
  @@index([importBatch])
  @@index([orderedDate])
  @@map("orders")
}

// ─── Imports ───────────────────────────────────────────────────────────────────

model ImportBatch {
  id             Int        @id @default(autoincrement())
  organizationId Int        @map("organization_id")
  batchId        String     @unique @map("batch_id")
  importType     ImportType @map("import_type")
  fileName       String?    @map("file_name")
  fileHash       String?    @map("file_hash")
  rowsImported   Int        @default(0) @map("rows_imported")
  rowsSkipped    Int        @default(0) @map("rows_skipped")
  salesCount     Int        @default(0) @map("sales_count")
  returnsCount   Int        @default(0) @map("returns_count")
  feesCount      Int        @default(0) @map("fees_count")
  statementNr    String?    @map("statement_nr")
  statementDate  String?    @map("statement_date")
  status         String     @default("completed")
  createdAt      DateTime   @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([batchId])
  @@index([createdAt])
  @@map("import_batches")
}

// ─── Statement Fees ────────────────────────────────────────────────────────────

model StatementFee {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  statementNr    String?  @map("statement_nr")
  statementDate  String?  @map("statement_date")
  feeType        String   @map("fee_type")
  description    String?
  exclVat        Decimal  @map("excl_vat") @db.Decimal(14, 4)
  vatAmount      Decimal  @map("vat_amount") @db.Decimal(12, 4)
  inclVat        Decimal  @map("incl_vat") @db.Decimal(14, 4)
  importBatch    String   @map("import_batch")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([importBatch])
  @@index([statementNr])
  @@map("statement_fees")
}

// ─── Noon Statement Summaries ─────────────────────────────────────────────────

model NoonStatementSummary {
  id                              Int      @id @default(autoincrement())
  organizationId                  Int      @map("organization_id")
  importBatchId                   String   @map("import_batch_id")
  referenceNr                     String   @map("reference_nr")
  statementDate                   String?  @map("statement_date")
  netProceeds                     Decimal  @default(0) @map("net_proceeds") @db.Decimal(14, 2)
  feesInclVat                     Decimal  @default(0) @map("fees_incl_vat") @db.Decimal(14, 2)
  feesExclVat                     Decimal  @default(0) @map("fees_excl_vat") @db.Decimal(14, 2)
  statementVat                    Decimal  @default(0) @map("statement_vat") @db.Decimal(12, 2)
  statementTotal                  Decimal  @default(0) @map("statement_total") @db.Decimal(14, 2)
  netAfterVat                     Decimal  @default(0) @map("net_after_vat") @db.Decimal(14, 2)
  tvTotal                         Decimal  @default(0) @map("tv_total") @db.Decimal(14, 2)
  difference                      Decimal  @default(0) @map("difference") @db.Decimal(10, 2)
  status                          String   @default("matched")
  vatEstimated                    Boolean  @default(true) @map("vat_estimated")
  orderRowsCount                  Int      @default(0) @map("order_rows_count")
  orderUpdateRowsCount            Int      @default(0) @map("order_update_rows_count")
  ignoredPaymentRowsCount         Int      @default(0) @map("ignored_payment_rows_count")
  ignoredBalanceTransferRowsCount Int      @default(0) @map("ignored_balance_transfer_rows_count")
  createdAt                       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, referenceNr])
  @@index([organizationId])
  @@index([importBatchId])
  @@map("noon_statement_summaries")
}

// ─── Audit Logs ────────────────────────────────────────────────────────────────

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  userId         Int?     @map("user_id")
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ─── Chart of Accounts ────────────────────────────────────────────────────────

model Account {
  id             Int           @id @default(autoincrement())
  organizationId Int           @map("organization_id")
  code           String
  nameAr         String        @map("name_ar")
  nameEn         String?       @map("name_en")
  accountType    AccountType   @map("account_type")
  normalBalance  NormalBalance @map("normal_balance")
  parentId       Int?          @map("parent_id")
  isActive       Boolean       @default(true) @map("is_active")
  description    String?
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  parent       Account?       @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]      @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
  @@map("accounts")
}

// ─── Journal Entries ───────────────────────────────────────────────────────────

model JournalEntry {
  id             Int           @id @default(autoincrement())
  organizationId Int           @map("organization_id")
  journalNumber  String?       @map("journal_number")
  entryDate      String        @map("entry_date")
  description    String?
  reference      String?
  status         JournalStatus @default(posted) @map("status")
  sourceType     String?       @map("source_type")
  sourceId       String?       @map("source_id")
  createdById    Int?          @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id])
  createdBy    User?          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  lines        JournalLine[]

  @@index([organizationId])
  @@index([entryDate])
  @@index([journalNumber])
  @@index([status])
  @@map("journal_entries")
}

model JournalLine {
  id        Int     @id @default(autoincrement())
  journalId Int     @map("journal_id")
  accountId Int?    @map("account_id")
  accountAr String  @map("account_ar")
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  notes     String?

  journal JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account?     @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

// ─── Journal Templates ─────────────────────────────────────────────────────────

model JournalTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  description    String?
  templateLines  Json     @map("template_lines")
  isActive       Boolean  @default(true) @map("is_active")
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("journal_templates")
}

// ─── Accounting Periods ────────────────────────────────────────────────────────

model AccountingPeriod {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  periodYear     Int       @map("period_year")
  periodMonth    Int       @map("period_month")
  isClosed       Boolean   @default(false) @map("is_closed")
  closedAt       DateTime? @map("closed_at")
  closedById     Int?      @map("closed_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  closedBy     User?        @relation("PeriodClosedBy", fields: [closedById], references: [id])

  @@unique([organizationId, periodYear, periodMonth])
  @@index([organizationId])
  @@map("accounting_periods")
}

// ─── Expense Categories ───────────────────────────────────────────────────────

model ExpenseCategory {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  accountCode    String?  @map("account_code")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  expenses     Expense[]

  @@index([organizationId])
  @@map("expense_categories")
}

// ─── Expenses ─────────────────────────────────────────────────────────────────

model Expense {
  id              Int           @id @default(autoincrement())
  organizationId  Int           @map("organization_id")
  expenseDate     String        @map("expense_date")
  vendor          String?
  categoryId      Int?          @map("category_id")
  description     String?
  amountBeforeVat Decimal       @map("amount_before_vat") @db.Decimal(14, 2)
  vatAmount       Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(14, 2)
  paymentMethod   PaymentMethod @default(bank_transfer) @map("payment_method")
  referenceNumber String?       @map("reference_number")
  notes           String?
  vatTreatment    String?       @map("vat_treatment")
  costCenter      String?       @map("cost_center")
  accountCode     String?       @map("account_code")
  attachmentData  Bytes?        @map("attachment_data")
  attachmentName  String?       @map("attachment_name")
  attachmentMime  String?       @map("attachment_mime")
  status          ExpenseStatus @default(draft) @map("status")
  journalEntryId  Int?          @map("journal_entry_id")
  createdById     Int?          @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  category     ExpenseCategory? @relation(fields: [categoryId], references: [id])
  createdBy    User?            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([expenseDate])
  @@index([status])
  @@index([categoryId])
  @@map("expenses")
}

// ─── Reference Sequences ──────────────────────────────────────────────────────

model ReferenceSequence {
  id      Int    @id @default(autoincrement())
  orgId   Int    @map("org_id")
  prefix  String
  year    Int
  lastSeq Int    @default(0) @map("last_seq")

  @@unique([orgId, prefix, year])
  @@map("reference_sequences")
}

// ─── Platform / SaaS Layer ────────────────────────────────────────────────────

model Merchant {
  id              Int            @id @default(autoincrement())
  businessName    String         @map("business_name")
  ownerName       String?        @map("owner_name")
  email           String?
  phone           String?
  crNumber        String?        @map("cr_number")
  vatNumber       String?        @map("vat_number")
  status          MerchantStatus @default(trial)
  organizationId  Int?           @map("organization_id")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  lastActivityAt  DateTime?      @map("last_activity_at")

  organization  Organization?    @relation(fields: [organizationId], references: [id])
  subscriptions Subscription[]
  payments      PlatformPayment[]

  @@index([status])
  @@index([organizationId])
  @@map("merchants")
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String
  code          String   @unique
  monthlyPrice  Decimal  @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice   Decimal  @map("yearly_price")  @db.Decimal(10, 2)
  features      Json     @default("[]")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id           Int                @id @default(autoincrement())
  merchantId   Int                @map("merchant_id")
  planId       Int                @map("plan_id")
  billingCycle BillingCycle       @default(monthly) @map("billing_cycle")
  startDate    DateTime           @map("start_date")
  endDate      DateTime?          @map("end_date")
  status       SubscriptionStatus @default(trial)
  autoRenew    Boolean            @default(true) @map("auto_renew")
  price        Decimal            @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  merchant Merchant          @relation(fields: [merchantId], references: [id])
  plan     Plan              @relation(fields: [planId], references: [id])
  payments PlatformPayment[]

  @@index([merchantId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

model PlatformPayment {
  id             Int                   @id @default(autoincrement())
  merchantId     Int                   @map("merchant_id")
  subscriptionId Int?                  @map("subscription_id")
  amount         Decimal               @db.Decimal(10, 2)
  status         PlatformPaymentStatus @default(pending)
  paymentMethod  String?               @map("payment_method")
  invoiceNumber  String?               @map("invoice_number")
  notes          String?
  paidAt         DateTime?             @map("paid_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([merchantId])
  @@index([subscriptionId])
  @@map("platform_payments")
}
